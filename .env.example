# ---------------------------------------------------------------------------
# Frontend (Vite → Vercel). Copy to `.env.local` for local overrides.
# Every value here is baked into the browser bundle — never put secrets in it.
# ---------------------------------------------------------------------------

# Where the browser sends API calls.
#   - Leave empty locally: the Vite dev server proxies /api → wrangler dev on
#     http://127.0.0.1:8787 (see vite.config.ts).
#   - In production set this to the deployed Worker, e.g.
#     https://cosmic-invader-frontiers-api.<your-subdomain>.workers.dev/api
#   - Omit it only if you front the Worker with a same-origin /api rewrite.
VITE_API_BASE_URL=

# Public canonical origin. Used for canonical tags, Open Graph URLs, JSON-LD
# and the sitemap. Must be the domain users actually visit.
VITE_SITE_URL=https://cosmic-invader-frontiers.vercel.app

# Client build identifier sent as `X-Client-Version` and stored with replays.
VITE_CLIENT_VERSION=web-1.0.0

# Local only: where `vite dev` proxies /api. Defaults to the wrangler dev port.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Backend (Cloudflare Worker). These are *not* read by Vite.
#   Locally  → backend/.dev.vars   (copy from backend/.dev.vars.example)
#   Remotely → `wrangler secret put <NAME> --config backend/wrangler.toml`
# Non-secret configuration lives in [vars] inside backend/wrangler.toml.
# ---------------------------------------------------------------------------
# SESSION_SECRET="at-least-32-characters-of-random-signing-key"
# ADMIN_BOOTSTRAP_TOKEN="one-time-token-to-promote-the-first-operator"
